# --- Render (API) ---
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-app.vercel.app
GROQ_API_KEY=

# Supabase (tables + Storage bucket "hireflow")
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Redis for background workers (otherwise in-process queue on the API host)
# REDIS_URL=

# Optional LLM overrides (defaults: openai/gpt-oss-20b / openai/gpt-oss-120b)
# LLM_MODEL_FAST=openai/gpt-oss-20b
# LLM_MODEL_STRONG=openai/gpt-oss-120b

# --- Local dev ---
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Vercel (apps/web) ---
# HIREFLOW_API_URL=https://hireflow-api.onrender.com

